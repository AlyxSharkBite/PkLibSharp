<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are console applications rather than class libraries: the test
         host is Microsoft.Testing.Platform, linked into the test assembly itself. The runner is
         selected in global.json, which the .NET 10 SDK requires for MTP-based projects. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 carries its own Microsoft.Testing.Platform runner, so neither
         Microsoft.NET.Test.Sdk nor the VSTest adapter is needed any more. -->
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PkLibSharp\PkLibSharp.csproj" />
  </ItemGroup>

</Project>
